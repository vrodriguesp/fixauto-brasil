{
  "expo": {
    "name": "BipFix",
    "slug": "bipfix-cliente",
    "scheme": "bipfix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bipfix.cliente",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to find repair shops near you.",
        "NSCameraUsageDescription": "We use the camera so you can photograph the damage to your vehicle.",
        "NSPhotoLibraryUsageDescription": "We use your photo library so you can send photos of the damage to your vehicle."
      },
      "associatedDomains": [
        "applinks:bipfix.com"
      ]
    },
    "android": {
      "package": "com.bipfix.cliente",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bipfix.com",
              "pathPattern": "/.*/confirmar-email"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "We use your photo library so you can send photos of the damage to your vehicle.",
          "cameraPermission": "We use the camera so you can photograph the damage to your vehicle."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to find repair shops near you."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "locales": {
      "en": "./i18n/permissoes/en.json",
      "pt": "./i18n/permissoes/pt.json",
      "pt-PT": "./i18n/permissoes/pt-PT.json",
      "et": "./i18n/permissoes/et.json",
      "it": "./i18n/permissoes/it.json",
      "ru": "./i18n/permissoes/ru.json"
    }
  }
}
